# AWS Credentials & Configuration (Leave default for local offline mode)
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 & DynamoDB Configuration
F1_S3_BUCKET=f1-telemetry-raw-free-tier
F1_DYNAMODB_TABLE=f1-telemetry-stints
F1_ATHENA_DATABASE=f1_telemetry_db

# Local Pipeline Configuration
F1_CACHE_DIR=.fastf1_cache
F1_DATA_DIR=data
F1_OFFLINE_MODE=true
